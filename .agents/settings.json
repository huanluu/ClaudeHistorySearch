{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/pre-commit-lint.sh\"",
            "statusMessage": "Running lint and tests before commit..."
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/check-code-review.sh\"",
            "statusMessage": "Checking code review status..."
          }
        ]
      }
    ]
  }
}
